; Engine configuration file.
config_version=5

[application]

config/name="Toy Squad"
config/description="Tiny plastic soldiers, giant battlefields."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/bg_color=Color(0.07, 0.09, 0.12, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"
Ads="*res://scripts/ads.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/LilitaOne-Regular.ttf"
theme/default_font_antialiasing=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
